<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex, nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ name }} — {{ city }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root { --accent: {{ accent }}; --accent-dark: {{ accent_dark }}; --ink: #f5f5f5; --paper: #0d0d0f; --paper-alt: #18181b; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Inter', system-ui, sans-serif; color: var(--ink); background: var(--paper); line-height: 1.55; overflow-x: hidden; }
  h1, .brand-font { font-family: 'Archivo Black', sans-serif; text-transform: uppercase; }
  .badge { display: inline-block; background: var(--paper-alt); border: 1px solid #333; color: #ccc; padding: .35rem .9rem; border-radius: 999px; font-size: .75rem; }

  @keyframes kenburns { from { background-size: 108% auto; } to { background-size: 126% auto; } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes scanline { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }

  header.hero {
    position: relative; min-height: 82vh; display: flex; align-items: flex-end; padding: 3rem 1.5rem; overflow: hidden;
    background: linear-gradient(0deg, rgba(0,0,0,.88), rgba(0,0,0,.35)), #000;
    {% if hero_image %}
    background-image: linear-gradient(0deg, rgba(5,5,5,.9), rgba(5,5,5,.3)), url('{{ hero_image.url | safe }}');
    background-position: center; background-repeat: no-repeat;
    animation: kenburns 16s ease-in-out infinite alternate;
    {% endif %}
  }
  header.hero::after {
    content: ""; position: absolute; top: 0; left: 0; width: 40%; height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255,255,255,.05), transparent);
    animation: scanline 7s ease-in-out infinite; pointer-events: none;
  }
  .hero-inner { max-width: 980px; margin: 0 auto; width: 100%; position: relative; z-index: 2; }
  .hero-inner > * { opacity: 0; animation: fadeUp .7s ease forwards; }
  .hero-inner .badge { animation-delay: .05s; }
  .hero-inner .tagline { animation-delay: .16s; }
  .hero-inner h1 { animation-delay: .28s; }
  .hero-inner .sub { animation-delay: .42s; }
  .hero-inner .cta { animation-delay: .56s; }
  .tagline { color: var(--accent); font-weight: 700; letter-spacing: .1em; margin-bottom: .8rem; font-size: .9rem; text-transform: uppercase; }
  h1 { font-size: clamp(2.4rem, 6.5vw, 4.6rem); line-height: .98; margin: 0 0 1rem; letter-spacing: -.01em; }
  .sub { font-size: 1.15rem; color: #cfcfcf; max-width: 46ch; margin: 0 0 1.8rem; }
  .cta { display: inline-block; padding: .9rem 2rem; background: var(--accent); color: #050505; text-decoration: none; border-radius: 2px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; font-size: .9rem; transition: background .15s, color .15s, transform .15s; }
  .cta:hover { background: var(--accent-dark); color: #fff; transform: translateY(-2px); }

  main { max-width: 980px; margin: 0 auto; padding: 0 1.5rem; }
  .highlights { display: flex; flex-wrap: wrap; gap: 0; border-top: 1px solid #262626; border-bottom: 1px solid #262626; margin: 3.5rem 0; }
  .highlight { flex: 1 1 200px; padding: 1.6rem 1rem; border-right: 1px solid #262626; transition: background .2s; }
  .highlight:hover { background: var(--paper-alt); }
  .highlight:last-child { border-right: none; }
  .highlight .num { color: var(--accent); font-weight: 800; font-family: 'Archivo Black', sans-serif; font-size: .85rem; display: block; margin-bottom: .5rem; }
  section { margin: 4rem 0; }
  h2 { font-size: 1.9rem; margin-bottom: 1.4rem; letter-spacing: -.01em; }
  .about p { font-size: 1.1rem; color: #d8d8d8; max-width: 68ch; }
  .services { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0; }
  .service { padding: 1.4rem 0; border-bottom: 1px solid #262626; display: flex; gap: 1rem; align-items: baseline; transition: transform .2s, padding-left .2s; }
  .service:hover { transform: translateX(6px); }
  .service .idx { font-family: 'Archivo Black', sans-serif; color: var(--accent); font-size: 1.1rem; flex-shrink: 0; }
  .service h3 { margin: 0 0 .3rem; font-size: 1.05rem; }
  .service p { margin: 0; font-size: .9rem; color: #a3a3a3; }
  .gallery { display: grid; grid-template-columns: 1.3fr 1fr; gap: .8rem; grid-auto-rows: 140px; }
  .gallery a { display: block; overflow: hidden; border-radius: 4px; background: #18181b; }
  .gallery a:first-child { grid-row: span 2; height: 100%; }
  /* Das asymmetrische Raster oben braucht drei Bilder. Liefert Pexels weniger,
     wuerde eine Spalte leer bleiben - dann lieber gleichmaessig verteilen. */
  .gallery.gallery-few { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); grid-auto-rows: auto; }
  .gallery.gallery-few a:first-child { grid-row: auto; height: auto; }
  .gallery img { width: 100%; height: 140px; object-fit: cover; display: block; transition: transform .5s ease, filter .5s ease; }
  .gallery a:first-child img { height: 100%; }
  .gallery a:hover img { transform: scale(1.08); filter: brightness(1.1); }
  .meta-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; background: var(--paper-alt); border-radius: 4px; padding: 1.8rem; border: 1px solid #262626; }
  .meta-item b { display: block; font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; color: var(--accent); margin-bottom: .3rem; }
  .hours-list { list-style: none; padding: 0; margin: 0; font-size: .95rem; color: #d8d8d8; }
  footer { text-align: center; padding: 2.5rem 1.5rem; font-size: .78rem; color: #666; border-top: 1px solid #262626; margin-top: 3rem; }
  footer a { color: #888; }

  /* Handy: Die Stichpunkte stehen gestapelt statt nebeneinander - dann ist eine
     RECHTE Trennlinie sinnlos und erscheint als abgeschnittener Strich. Waagerecht
     trennen und enger setzen, damit Nummer und Text zusammengehoerig wirken. */
  @media (max-width: 680px) {
    .highlight { flex: 1 1 100%; padding: 1rem .2rem; border-right: none;
                 border-bottom: 1px solid #262626; }
    .highlight:last-child { border-bottom: none; }
    .highlight .num { display: inline; margin-right: .5rem; }
    /* Das asymmetrische Bildraster braucht Breite - auf dem Handy untereinander. */
    .gallery { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .gallery a:first-child { grid-row: auto; height: auto; }
    .gallery img, .gallery a:first-child img { height: 200px; }
    h1 { font-size: clamp(2rem, 11vw, 2.8rem); }
  }

  .reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .7s ease; }
  .reveal.is-visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    header.hero, header.hero::after, .hero-inner > * { animation: none; opacity: 1; }
  }

  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.75); display: none; align-items: center; justify-content: center; z-index: 100; padding: 1rem; }
  .modal-overlay.open { display: flex; }
  .modal-box { background: var(--paper-alt); color: var(--ink); border-radius: 6px; padding: 2rem; max-width: 420px; width: 100%; position: relative; max-height: 90vh; overflow-y: auto; border: 1px solid #333; }
  .modal-close { position: absolute; top: .8rem; right: 1rem; background: none; border: none; font-size: 1.5rem; cursor: pointer; color: inherit; line-height: 1; }
  .modal-box h3 { margin-top: 0; font-family: 'Archivo Black', sans-serif; text-transform: uppercase; font-size: 1.2rem; }
  .modal-note { font-size: .85rem; color: #a3a3a3; }
  .modal-box form label { display: block; font-size: .8rem; font-weight: 700; margin: .8rem 0 .3rem; text-transform: uppercase; letter-spacing: .04em; }
  .modal-box input, .modal-box textarea { width: 100%; padding: .6rem .7rem; border: 1px solid #333; background: #0d0d0f; color: var(--ink); border-radius: 4px; font: inherit; }
  .modal-row { display: flex; gap: 1rem; }
  .modal-row label { flex: 1; }
  .modal-submit { margin-top: 1.2rem; width: 100%; padding: .8rem; background: var(--accent); color: #050505; border: none; border-radius: 2px; font-weight: 800; cursor: pointer; font-size: .9rem; text-transform: uppercase; letter-spacing: .04em; transition: background .15s; }
  .modal-submit:hover { background: var(--accent-dark); }
  .modal-success { display: none; }
  .modal-tel { display: block; text-align: center; margin-top: 1rem; font-size: .85rem; color: #a3a3a3; }
</style>
</head>
<body>
<header class="hero">
  <div class="hero-inner">
    <span class="badge">Unverbindlicher Website-Entwurf{% if not (hero_image and hero_image.echt) %} · Fotos sind Symbolbilder{% endif %}</span>
    <div class="tagline">{{ tagline }}</div>
    <h1>{{ headline }}</h1>
    <p class="sub">{{ subheadline }}</p>
    <a class="cta" href="#" onclick="openReservationModal(event)">{{ cta_text }}</a>
  </div>
</header>
<main>
  <div class="highlights">
    {% for h in highlights %}<div class="highlight reveal" style="transition-delay: {{ loop.index0 * 0.08 }}s"><span class="num">0{{ loop.index }}</span>{{ h }}</div>{% endfor %}
  </div>

  <section class="about reveal">
    <h2>Über uns</h2>
    <p>{{ about }}</p>
  </section>

  <section>
    <h2 class="reveal">Angebot</h2>
    <div class="services">
      {% for s in services %}
      <div class="service reveal" style="transition-delay: {{ loop.index0 * 0.06 }}s"><span class="idx">0{{ loop.index }}</span><div><h3>{{ s.name }}</h3><p>{{ s.description }}</p></div></div>
      {% endfor %}
    </div>
  </section>

  {% if gallery_images %}
  <section>
    <h2 class="reveal">Impressionen</h2>
    <div class="gallery{% if gallery_images|length < 3 %} gallery-few{% endif %}">
      {% for img in gallery_images %}
      <a class="reveal" href="{{ img.source_url }}" style="transition-delay: {{ loop.index0 * 0.1 }}s" target="_blank" rel="noopener">
        <img src="{{ img.url }}" alt="{{ category }} Impression" loading="lazy">
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="meta-grid reveal">
    {% if address %}<div class="meta-item"><b>Adresse</b>{{ address }}</div>{% endif %}
    {% if phone %}<div class="meta-item"><b>Telefon</b>{{ phone }}</div>{% endif %}
    {% if rating %}<div class="meta-item"><b>Bewertung</b>⭐ {{ rating }} ({{ review_count }})</div>{% endif %}
    {% if opening_hours %}
    <div class="meta-item"><b>Öffnungszeiten</b>
      <ul class="hours-list">{% for line in opening_hours %}<li>{{ line }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
  </section>
</main>
<footer>
  Dies ist ein unverbindlicher Demo-Entwurf für {{ name }}, erstellt zu Vorstellungszwecken — keine offizielle Website des Betriebs.
  {% if hero_image %}<br>Foto: <a href="{{ hero_image.source_url }}">{{ hero_image.photographer }}</a>{% if hero_image.echt %} via Wikimedia Commons{% if hero_image.lizenz %}, Lizenz {% if hero_image.lizenz_url %}<a href="{{ hero_image.lizenz_url }}">{{ hero_image.lizenz }}</a>{% else %}{{ hero_image.lizenz }}{% endif %}{% endif %}.{% else %} via Pexels (Symbolbild, kein echtes Foto des Betriebs).{% endif %}{% endif %}
</footer>

<div class="modal-overlay" id="reservationModal">
  <div class="modal-box">
    <button class="modal-close" type="button" onclick="closeReservationModal()">&times;</button>
    <h3>Anfrage an {{ name }}</h3>
    <p class="modal-note">Unverbindliche Anfrage — {{ name }} meldet sich zur Bestätigung bei Ihnen.</p>
    <form id="reservationForm">
      <label>Name<input type="text" name="customer_name" required></label>
      <label>Telefon oder E-Mail<input type="text" name="contact" required></label>
      <div class="modal-row">
        <label>Datum<input type="date" name="date"></label>
        <label>Uhrzeit<input type="time" name="time"></label>
      </div>
      {% if category in ['restaurant', 'bar', 'cafe'] %}
      <label>Personen<input type="number" name="party_size" min="1" max="20" value="2"></label>
      {% endif %}
      <label>Nachricht (optional)<textarea name="message" rows="2"></textarea></label>
      <button type="submit" class="modal-submit">Anfrage senden</button>
    </form>
    <div class="modal-success" id="reservationSuccess">
      <p>✓ Danke, {{ name }} hat Ihre Anfrage erhalten.</p>
      <p class="modal-note">Hinweis: Dies ist eine Demo-Website zu Vorstellungszwecken.</p>
    </div>
    <div class="modal-success" id="reservationError">
      <p>Die Anfrage konnte leider nicht übermittelt werden.</p>
      <p class="modal-note">Bitte versuchen Sie es später noch einmal{% if phone %} oder rufen Sie direkt an: {{ phone }}{% endif %}.</p>
    </div>
    {% if phone %}<a class="modal-tel" href="tel:{{ phone }}">oder direkt anrufen: {{ phone }}</a>{% endif %}
  </div>
</div>

<script>
  // rootMargin: Abschnitte werden schon 300px VOR dem Sichtbarwerden eingeblendet.
  // Auf dem Handy scrollt man schneller als die Einblendung dauert - ohne Vorlauf
  // sieht man leere Flaechen und haelt die Seite fuer kaputt.
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
    });
  }, { threshold: 0.05, rootMargin: '300px 0px' });
  document.querySelectorAll('.reveal').forEach(function(el) { io.observe(el); });

  // Sicherheitsnetz: Falls der Beobachter aus irgendeinem Grund nicht ausloest, waere
  // der Inhalt dauerhaft unsichtbar. Nach 2,5s alles zeigen, was noch versteckt ist -
  // lieber ohne Animation sichtbar als mit Animation unsichtbar.
  setTimeout(function() {
    document.querySelectorAll('.reveal:not(.is-visible)').forEach(function(el) {
      el.classList.add('is-visible');
    });
  }, 2500);

  function openReservationModal(e) { if (e) e.preventDefault(); document.getElementById('reservationModal').classList.add('open'); }
  function closeReservationModal() { document.getElementById('reservationModal').classList.remove('open'); }
  var reservationForm = document.getElementById('reservationForm');
  reservationForm.addEventListener('submit', function(ev) {
    ev.preventDefault();
    var data = Object.fromEntries(new FormData(ev.target));
    fetch('{{ api_base }}/api/reservation/{{ slug }}', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) })
      .then(function(res) {
        if (!res.ok) { throw new Error('HTTP ' + res.status); }
        reservationForm.style.display = 'none';
        document.getElementById('reservationSuccess').style.display = 'block';
      })
      .catch(function() {
        // Ehrlich bleiben: Erfolg nur melden, wenn die Anfrage wirklich angekommen ist.
        reservationForm.style.display = 'none';
        document.getElementById('reservationError').style.display = 'block';
      });
  });
</script>
</body>
</html>
