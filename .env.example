# --- Lead-Quelle ---
# OpenStreetMap (Overpass API) - komplett kostenlos, kein Account, kein Key noetig.

# --- KI (Website-Texte + E-Mail-Entwuerfe) ---
# Kostenloser Groq-Key: https://console.groq.com/keys
GROQ_API_KEY=
ANALYSIS_MODEL=openai/gpt-oss-120b

# --- Stockfotos fuer die Demo-Sites ---
# Kostenlos, kein Kreditkarte, sofortiger Key nach Anmeldung: https://www.pexels.com/api/
# Ohne Key funktioniert die Site-Generierung trotzdem (nur ohne Fotos).
PEXELS_API_KEY=

# --- Mailversand (SMTP) ---
# Beliebiger SMTP-Zugang funktioniert, z.B. Brevo (ehem. Sendinblue, 300 Mails/Tag
# gratis, https://app.brevo.com/settings/keys/smtp) oder ein Gmail-App-Passwort.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=Dein Name oder Firma

# Erscheint als Signatur/Anbieterkennzeichnung unter jeder Mail. Pflichtangaben nach
# TMG/UWG - vollstaendiger Name, Anschrift, Kontaktmoeglichkeit.
SENDER_IMPRESSUM=Vorname Nachname, Strasse Hausnr, PLZ Ort, deine@email.de, +49...

# --- Zielgebiet ---
# Staedtenamen muessen exakt dem OSM-Verwaltungsgrenzen-Namen entsprechen (mit Umlauten).
# Grosse Liste (~55 deutsche Staedte), damit ueber die Zeit genug qualifizierte Leads
# zusammenkommen - der Filter (keine Website + bekannte Mail) laesst nur wenige % durch.
SEARCH_CITIES=Berlin,Hamburg,München,Köln,Frankfurt am Main,Stuttgart,Düsseldorf,Leipzig,Dortmund,Essen,Bremen,Dresden,Hannover,Nürnberg,Duisburg,Bochum,Wuppertal,Bielefeld,Bonn,Münster,Karlsruhe,Mannheim,Augsburg,Wiesbaden,Mönchengladbach,Braunschweig,Chemnitz,Kiel,Aachen,Magdeburg,Freiburg im Breisgau,Krefeld,Lübeck,Erfurt,Mainz,Rostock,Kassel,Potsdam,Saarbrücken,Oldenburg,Osnabrück,Leverkusen,Heidelberg,Darmstadt,Regensburg,Paderborn,Ingolstadt,Würzburg,Wolfsburg,Trier,Reutlingen,Koblenz,Jena,Erlangen,Siegen,Hildesheim
# Gueltige Kategorien: restaurant, hair_salon, bakery, cafe, bar, gym, florist
# (siehe CATEGORY_OSM_TAGS in app/sources/overpass.py fuer die Zuordnung zu OSM-Tags)
SEARCH_CATEGORIES=restaurant,hair_salon,bakery,cafe,bar,gym,florist

# Sicherheitsbremsen
MAX_LEADS_PER_RUN=20
MAX_EMAILS_PER_DAY=15

DB_PATH=data/app.db
PORT=8000
BASE_URL=http://localhost:8000

# Mindestabstand zwischen Durchlaeufen - bei dieser Listengroesse dauert ein voller
# Durchlauf laenger als das, die Pipeline laeuft also praktisch durchgehend (siehe config.py).
POLL_INTERVAL_PIPELINE_SEC=60
LOG_LEVEL=INFO
